# ====================================================================
# FeedbackIQ — Backend Environment Configuration
# ====================================================================

# Supabase PostgreSQL Integration
# (Leave empty to use automatic zero-config local JSON storage in backend/data/local_db.json)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Generative AI / LLM Configuration
# (Leave empty to use built-in offline deterministic NLP synthesis and SentenceTransformers)
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-1.5-flash

# Optional individual provider keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hindsight AI Long-Term Contextual Memory Configuration
# (Strict $5 credit conservation mode)
HINDSIGHT_ENABLED=true
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=feedbackiq_memory
HINDSIGHT_MAX_RETAINS_PER_ANALYSIS=1
HINDSIGHT_MAX_RECALLS_PER_REQUEST=1
HINDSIGHT_CACHE_ENABLED=true
HINDSIGHT_MAX_CALLS_PER_SESSION=50
HINDSIGHT_CACHE_TTL=3600

# Server Configuration
PORT=8000
HOST=0.0.0.0
