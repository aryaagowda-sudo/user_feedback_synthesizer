# ====================================================================
# FeedbackIQ — Frontend Environment Configuration
# ====================================================================

# Supabase Authentication & Client
# (Never expose your SUPABASE_SERVICE_ROLE_KEY or LLM_API_KEY in the frontend!)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Endpoint
# (Defaults to /api via Vite reverse proxy in development, or set full URL for production)
VITE_API_URL=http://localhost:8000
